# Конфигурация Lombok для всего проекта.
#
# addLombokGeneratedAnnotation: Lombok помечает сгенерированные методы (геттеры,
# сеттеры, equals/hashCode/toString) аннотацией @lombok.Generated, а JaCoCo
# исключает её из отчёта покрытия. Без этого «покрытие» размывалось бойлерплейтом,
# который никто не должен тестировать вручную.
config.stopBubbling = true
lombok.addLombokGeneratedAnnotation = true
